<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Target Name="RequireDapperDll" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(DapperDll)' == '' Or !Exists('$(DapperDll)')"
           Text="Supply an existing Dapper assembly with -p:DapperDll=/absolute/path/to/Dapper.dll." />
  </Target>
  <ItemGroup>
    <Reference Include="Dapper" HintPath="$(DapperDll)" Private="true" />
  </ItemGroup>
</Project>
